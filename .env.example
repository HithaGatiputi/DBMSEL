# ---- AI provider -----------------------------------------------------------
# auto (default): first available of Claude -> Gemini -> local Ollama -> offline.
LLM_PROVIDER=auto

# FREE option (cloud): Google Gemini API. Get a free key at https://aistudio.google.com
#   (a Gemini Pro *subscription* does not include API access; the AI Studio key is separate and free)
#   Put the key in ~/.dbmsel/secrets.env, NOT here, so it never ends up in a zipped project:
#   echo 'GEMINI_API_KEY=your-key' >> ~/.dbmsel/secrets.env
GEMINI_MODEL=gemini-flash-latest

# FREE option (offline): local model through Ollama (no account, no key, works without internet)
#   ollama pull qwen2.5-coder:7b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# PAID option: Claude via the Anthropic API (prepaid credits at console.anthropic.com;
#   a claude.ai Pro/Max subscription does NOT include API usage)
#   Key belongs in ~/.dbmsel/secrets.env:  echo 'ANTHROPIC_API_KEY=sk-ant-...' >> ~/.dbmsel/secrets.env
#   Price per 1M tokens (input/output): opus-5-5 $4/$20, sonnet-5-5 $2/$10, haiku-5-5 $0.10/$0.50
LLM_MODEL=claude-opus-5-5

# ---- Demo data -------------------------------------------------------------
# Which held-out CTU-13 scenarios to replay into the demo data (comma separated)
CTU_SCENARIOS=5,11,12
